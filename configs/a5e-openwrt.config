# A5E OpenWrt 定制 fragment
#
# 用法：追加到 radxa.config 之后（Kbuild merge_config 语义）
#   make KERNEL_DEFCONFIG="defconfig radxa.config a5e-openwrt.config" build
#
# 原则：
#   - 只显式打开**顶层必需** CONFIG；子依赖由内核 Kconfig 自动 select（例：BRIDGE 会带出 LLC/STP；
#     NF_TABLES 会带出 NETFILTER_NETLINK / NF_TABLES_INET 等）
#   - 目标是**让 bridge 和 firewall4 所需的核心子系统进 vmlinux**，避免走 OpenWrt kmodloader
#     对 aw2607 内核模块格式的依赖解析失灵问题（详见主记录文档坑 7）
#   - 若后续 fw4 运行时报缺某个 nft_* 表达式，**只往这里加一行**，不动其它

# ===== bridge (LAN br-lan) =====
# CONFIG_BRIDGE select LLC / STP；BRIDGE_NETFILTER 让 br-lan 支持 netfilter 过滤（fw4 需要）
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# ===== firewall4 (nftables) 核心 =====
# NF_TABLES select NETFILTER_NETLINK 等；NF_CONNTRACK 是 fw4 状态/连接跟踪底座；
# NF_NAT 是 NAT/MASQUERADE/REDIRECT 的底座
CONFIG_NF_TABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y

# ===== fw4 生成规则实际会用的 nft_* 表达式 =====
# 这些 Kconfig 不会被自动 select，fw4 用到什么就加什么
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_FLOW_OFFLOAD=y

# fib 系列（fw4 生成 iif/oif 路由判定时直接用 nft_fib 表达式）
# NFT_FIB 是父，不开它 NFT_FIB_INET / _IPV4 / _IPV6 都不会进 vmlinux
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_NETDEV=y

# ===== 桥 netfilter 表达式（br-lan 上的 fw4 规则要用）=====
# NF_TABLES_BRIDGE 是父 menuconfig，不开它下面的 NFT_BRIDGE_* 子项都不会进 .config
# NFT_BRIDGE_REJECT 额外需要 NF_REJECT_IPV4 / _IPV6
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y

# ===== 透明代理（tproxy / socket 匹配 / dup）=====
# ImmortalWrt 下 PassWall / OpenClash / Lucky / mosdns-tproxy 等透明代理
# 方案常见依赖的 kmod（对应内核 CONFIG）：
#   kmod-nft-tproxy → CONFIG_NFT_TPROXY
#   kmod-nf-tproxy  → CONFIG_NF_TPROXY_IPV4 / _IPV6
#   kmod-nf-socket  → CONFIG_NF_SOCKET_IPV4 / _IPV6（socket 匹配底层，与 tproxy 搭配）
#   kmod-ipt-tproxy → CONFIG_NETFILTER_XT_TARGET_TPROXY + CONFIG_NETFILTER_XT_MATCH_SOCKET
#   kmod-nft-dup / kmod-nf-dup → CONFIG_NF_DUP_*
# 把这一整组都 builtin，避免任何“tproxy 服务启动失败”类问题
CONFIG_NFT_TPROXY=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y

# iptables 兼容层（xt_tproxy 需要 NETFILTER_XTABLES=y 且 IP_NF_MANGLE=y 才能变 =y）
# 保留 iptables 目标主要为了 PassWall 等包里的旧式规则不 
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_FILTER=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NF_DUP_IPV4=y
CONFIG_NF_DUP_IPV6=y
CONFIG_NF_DUP_NETDEV=y

# ===== 支撑（defrag / 日志 / flow table）=====
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y

# ---------------------------------------------------------------------
