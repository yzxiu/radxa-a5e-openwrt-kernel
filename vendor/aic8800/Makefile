obj-$(CONFIG_AICV_WLAN_SUPPORT) += aic8800_bsp/       # bsp 最先：builtin 时 initcall 按链接顺序执行
obj-$(CONFIG_AICV8800_WLAN_SUPPORT) += aic8800_fdrv/
obj-$(CONFIG_AICV8800_BTLPM_SUPPORT) += aic8800_btlpm/


########## config option ##########
export CONFIG_USE_FW_REQUEST = n
export CONFIG_PREALLOC_RX_SKB = y
export CONFIG_PREALLOC_TXQ = y
export CONFIG_OOB = n
export CONFIG_GPIO_WAKEUP = n
export CONFIG_RESV_MEM_SUPPORT = y
